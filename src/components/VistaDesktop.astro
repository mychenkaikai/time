---
import VistaIcon from './VistaIcon.astro';
import '../styles/desktop-skins.css';
import { getAboutPath, getArchivePath, getTagIndexPath, withBase } from '../lib/routes';
const skins = [
  { id: 'vista', name: 'Windows Vista', detail: '2007 · Aero 玻璃', label: 'Vista', image: '/images/vista/aurora.svg' },
  { id: 'xp', name: 'Windows XP', detail: '2001 · 蓝天与绿草', label: 'XP', image: '/images/desktop/xp.svg' },
  { id: 'win2000', name: 'Windows 2000', detail: '2000 · 专业与简洁', label: '2000', image: '' },
  { id: 'win98', name: 'Windows 98', detail: '1998 · 最初的桌面', label: '98', image: '' },
  { id: 'osx', name: 'Mac OS X', detail: '10.5 · Leopard 拟物', label: 'Mac OS X', image: '/images/desktop/osx.svg' },
];
const shortcuts = [
  { icon: 'computer', label: '计算机', action: 'welcome' },
  { icon: 'folder', label: '个人文件夹', action: 'files' },
  { icon: 'network', label: '网络', action: 'network' },
  { icon: 'recycle', label: '回收站', action: 'recycle' },
];
const destinations = [
  { icon: 'documents', title: '文章归档', description: '打开收藏的文字与回忆', href: getArchivePath() },
  { icon: 'pictures', title: '标签索引', description: '按主题浏览数字藏品', href: getTagIndexPath() },
  { icon: 'person', title: '关于我', description: '认识这张桌面的主人', href: getAboutPath() },
];
---
<div id="desktop-shell" class="vista-desktop" data-vista-desktop data-desktop-skin="vista" style={`--wallpaper: url('${withBase('/images/vista/aurora.svg')}'); --xp-wallpaper: url('${withBase('/images/desktop/xp.svg')}'); --osx-wallpaper: url('${withBase('/images/desktop/osx.svg')}')`}>
  <script is:inline>
    try {
      const saved = localStorage.getItem('museum-desktop-skin');
      if (['vista', 'xp', 'win2000', 'win98', 'osx'].includes(saved)) document.getElementById('desktop-shell').dataset.desktopSkin = saved;
    } catch {}
  </script>
  <nav class="mac-menubar" aria-label="桌面菜单"><button data-open="appearance" aria-label="系统外观"><svg width="16" height="19" viewBox="0 0 24 28" aria-hidden="true"><path fill="currentColor" d="M15 6c2-1 4-4 3-6-3 0-5 2-5 5v1h2ZM20 15c0-3 2-4 3-5-2-3-5-3-6-3-2 0-4 1-5 1S9 7 7 7C3 7 1 10 1 14c0 6 4 13 7 13 2 0 3-1 5-1s3 1 5 1c2 0 5-4 6-7-3-1-4-3-4-5Z"/></svg></button><button data-open="files"><b>Finder</b></button><button data-open="files">文件</button><button data-open="appearance">外观</button><button data-open="welcome">窗口</button><button data-open="help">帮助</button><time data-mac-time></time></nav>
  <div class="desktop-shortcuts" aria-label="桌面图标">
    {shortcuts.map(item => <button class="desktop-shortcut" data-open={item.action} title={`打开${item.label}`}><VistaIcon name={item.icon}/><span>{item.label}</span></button>)}
    <button class="desktop-shortcut" data-open="appearance" title="打开个性化"><VistaIcon name="paint"/><span>个性化</span></button>
  </div>

  <main class="aero-window" data-aero-window aria-label="欢迎中心" tabindex="-1">
    <header class="aero-titlebar" data-drag-handle>
      <div class="window-caption"><VistaIcon name="computer" size={18}/><span data-caption>欢迎中心</span></div>
      <div class="caption-buttons">
        <button data-minimize title="最小化" aria-label="最小化"><span class="minimize-mark"></span></button>
        <button data-maximize title="最大化" aria-label="最大化"><span class="maximize-mark"></span></button>
        <button class="close-button" data-close title="关闭" aria-label="关闭">×</button>
      </div>
    </header>
    <div class="navigation-bar">
      <button class="back-button" data-back aria-label="返回欢迎中心" title="返回欢迎中心">←</button>
      <span class="forward-button" aria-hidden="true">→</span>
      <span class="navigation-caret" aria-hidden="true">▾</span>
      <div class="address-bar"><VistaIcon name="computer" size={16}/><span>桌面</span><span class="crumb-arrow">›</span><span data-address>欢迎中心</span><span class="address-dropdown">▾</span></div>
      <button class="help-button" data-open="help" aria-label="帮助" title="桌面使用帮助">?</button>
    </div>
    <div class="window-interior">
      <section data-view="welcome">
        <div class="welcome-banner">
          <div class="welcome-copy"><h1>欢迎中心</h1><p>从这里开始，找回熟悉的时光。</p><div class="system-information"><strong>怀旧数字博物馆</strong><span data-skin-description>Windows Vista 风格桌面</span><span>文字、影像，以及那些值得留下的记忆</span></div></div>
          <div class="welcome-computer"><VistaIcon name="computer" size={132}/></div>
        </div>
        <div class="section-heading"><span>开始使用</span><span class="item-count">3 个项目</span></div>
        <div class="welcome-links">{destinations.map(item => <a class="welcome-link" href={item.href}><VistaIcon name={item.icon} size={46}/><span><strong>{item.title}</strong><small>{item.description}</small></span></a>)}</div>
        <div class="section-heading"><span>让桌面更有你的感觉</span></div>
        <div class="personalize-links">
          <button data-open="appearance"><VistaIcon name="paint" size={38}/><span>个性化桌面<small>调整窗口颜色与背景</small></span></button>
          <button data-toggle-gadgets><VistaIcon name="pictures" size={38}/><span>Windows 边栏<small>显示或隐藏桌面小工具</small></span></button>
          <button data-open="help"><VistaIcon name="network" size={38}/><span>探索这张桌面<small>一些熟悉的操作方式</small></span></button>
        </div>
        <div class="welcome-bottom"><span class="tiny-flag" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-skin-brand>Windows <b>Vista</b></span><span class="welcome-note">留一点时间，给过去。</span></div>
      </section>

      <section data-view="files" hidden>
        <div class="explorer-toolbar">组织 <span>▾</span><i></i>个人文件夹</div>
        <div class="explorer-layout"><aside class="explorer-sidebar"><strong>收藏夹链接</strong><button data-open="welcome">桌面</button><a href={getArchivePath()}>文档</a><a href={getTagIndexPath()}>图片与标签</a><hr/><span>文件夹</span></aside><div class="explorer-files">{destinations.map(item => <a href={item.href}><VistaIcon name={item.icon} size={64}/><span>{item.title}</span></a>)}</div></div>
      </section>
      <section data-view="network" hidden><div class="simple-panel"><VistaIcon name="network" size={72}/><h1>网络和共享中心</h1><p>沿着这些入口，继续探索数字博物馆。</p><div class="network-map"><span>这台计算机</span><span>━━━━</span><span>数字博物馆</span></div><a class="native-button" href={getArchivePath()}>浏览文章归档</a></div></section>
      <section data-view="recycle" hidden><div class="explorer-toolbar">组织 <span>▾</span><i></i>回收站</div><div class="empty-folder"><VistaIcon name="recycle" size={64}/><p>回收站是空的。</p><small>值得珍藏的回忆，都好好留着。</small></div></section>
      <section data-view="appearance" hidden>
        <div class="skin-panel"><h1>桌面主题</h1><p>熟悉的电脑，不同的年代。选择一套外观，立即换上。</p>
          <div class="skin-choices" role="group" aria-label="桌面主题">{skins.map(skin => <button class="skin-choice" data-skin-choice={skin.id} aria-pressed={skin.id === 'vista'}><span class:list={['skin-preview', `skin-preview--${skin.id}`]} style={skin.image ? `background-image: url('${withBase(skin.image)}')` : undefined}><span class="mini-window"><span class="mini-title">{skin.label}<i>×</i></span><span class="mini-content"><i></i><i></i><i></i></span></span><span class="mini-taskbar"></span></span><strong>{skin.name}</strong><small>{skin.detail}</small><span class="skin-check" aria-hidden="true">✓</span></button>)}</div>
          <p class="skin-save-status" data-skin-status role="status">当前主题：Windows Vista</p>
        </div>
        <div class="appearance-panel" data-vista-options><h2>Vista 窗口颜色和外观</h2><p>为这张桌面选择一种颜色。</p><div class="color-options" role="group" aria-label="窗口颜色"><button data-color="blue" class="selected" aria-pressed="true" title="冰蓝" aria-label="冰蓝" style="--swatch:#72b4d7"></button><button data-color="teal" aria-pressed="false" title="青绿" aria-label="青绿" style="--swatch:#6fbaa6"></button><button data-color="graphite" aria-pressed="false" title="石墨" aria-label="石墨" style="--swatch:#77838b"></button><button data-color="rose" aria-pressed="false" title="玫瑰" aria-label="玫瑰" style="--swatch:#c79eae"></button></div><label class="transparency-option"><input type="checkbox" data-transparency checked/> 启用透明效果</label><h2>桌面背景</h2><button class="wallpaper-choice" data-wallpaper aria-pressed="false"><img src={withBase('/images/vista/aurora.svg')} alt="蓝绿极光桌面背景" width="144" height="90"/><span>Windows Aurora</span><small>点击切换蓝色 / 绿色极光</small></button></div>
      </section>
      <section data-view="help" hidden><div class="simple-panel help-panel"><h1>熟悉的桌面，再次相遇。</h1><p>欢迎回来。可以从这几个地方开始：</p><ul><li>点击左侧桌面图标，打开对应窗口。</li><li>拖动标题栏，调整窗口位置。</li><li>右上角可以最小化、最大化和关闭窗口。</li><li>点击任务栏中的“欢迎中心”，重新打开窗口。</li><li>打开左下角的开始菜单，或在“个性化”里换一种颜色。</li></ul><p class="help-footnote">这是一张可以交互的网页桌面。</p></div></section>
    </div>
    <div class="window-status"><VistaIcon name="computer" size={17}/><span data-status>欢迎使用数字博物馆</span><span class="resize-grip" aria-hidden="true">◢</span></div>
  </main>

  <aside class="windows-sidebar" data-gadgets aria-label="Windows 边栏小工具">
    <div class="sidebar-tools"><button data-toggle-gadgets aria-label="隐藏边栏" title="隐藏边栏">×</button><span>Windows 边栏</span></div>
    <div class="clock-gadget" role="img" aria-label="时钟" data-clock-label><div class="clock-face">{Array.from({length:12}, (_, i) => <span class="clock-tick" style={`--tick:${i}`}></span>)}<span class="clock-number n12">12</span><span class="clock-number n3">3</span><span class="clock-number n6">6</span><span class="clock-number n9">9</span><span class="clock-brand">QUARTZ</span><i class="clock-hand hour-hand" data-hour-hand></i><i class="clock-hand minute-hand" data-minute-hand></i><i class="clock-hand second-hand" data-second-hand></i><i class="clock-pin"></i></div></div>
    <figure class="photo-gadget"><div class="photo-mat"><img src={withBase('/images/vista/landscape.svg')} width="480" height="300" alt="青山间蜿蜒的小路"/></div><figcaption>远方的风景</figcaption></figure>
    <div class="calendar-gadget"><div class="calendar-top" data-calendar-month></div><strong data-calendar-day></strong><span data-calendar-weekday></span><div class="calendar-bottom" data-calendar-year></div></div>
    <div class="sidebar-caption">慢一点，也很好。</div>
  </aside>

  <div class="desktop-signature"><span data-signature-brand>Windows Vista</span><span class="signature-edition">怀旧数字博物馆</span></div>

  <section class="start-menu" data-start-menu hidden aria-label="开始菜单">
    <div class="start-programs"><div class="start-program-list">{[{icon:'computer', label:'欢迎中心', action:'welcome'}, {icon:'folder',label:'个人文件夹',action:'files'}, {icon:'paint',label:'个性化',action:'appearance'}, {icon:'network',label:'网络和共享中心',action:'network'}, {icon:'recycle',label:'回收站',action:'recycle'}].map(item => <button data-open={item.action} data-program={item.label}><VistaIcon name={item.icon} size={34}/><span>{item.label}</span></button>)}<div class="start-separator"></div>{destinations.map(item => <a href={item.href} data-program={item.title}><VistaIcon name={item.icon} size={34}/><span>{item.title}</span></a>)}<p class="start-empty" data-start-empty hidden>没有找到匹配的项目</p></div><button class="all-programs" data-all-programs><span>▸</span> 所有程序</button><div class="start-search"><input type="search" placeholder="开始搜索" aria-label="搜索开始菜单" data-start-search/><span aria-hidden="true">⌕</span></div></div>
    <div class="start-places"><div class="user-tile"><VistaIcon name="person" size={55}/></div><strong class="user-name">时光访客</strong><button data-open="files">文档</button><a href={getTagIndexPath()}>图片</a><a href={getArchivePath()}>文章</a><div class="places-divider"></div><button data-open="welcome">计算机</button><button data-open="network">网络</button><div class="places-divider"></div><button data-open="appearance">个性化</button><button data-toggle-gadgets>Windows 边栏</button><button data-open="help">帮助和支持</button><div class="start-power"><button data-show-desktop title="显示桌面" aria-label="显示桌面">⏻</button><button data-dismiss-start title="关闭开始菜单" aria-label="关闭开始菜单">▸</button></div></div>
  </section>

  <footer class="vista-taskbar">
    <button class="start-button" data-start-toggle aria-label="开始" title="开始" aria-expanded="false"><span class="start-orb"><span class="windows-flag"><i></i><i></i><i></i><i></i></span></span><span class="start-label">开始</span></button>
    <div class="quick-launch"><button data-show-desktop aria-label="显示桌面" title="显示桌面"><VistaIcon name="computer" size={22}/></button><button data-open="files" aria-label="个人文件夹" title="个人文件夹"><VistaIcon name="folder" size={23}/></button><span class="quick-divider"></span></div>
    <button class="taskbar-window active" data-taskbar-window><VistaIcon name="computer" size={21}/><span data-taskbar-title>欢迎中心</span></button>
    <div class="system-tray"><span class="tray-chevron" aria-hidden="true">‹</span><span class="network-tray" aria-label="网络"><i></i><i></i></span><span class="volume-tray" aria-label="音量">◖))</span><span class="tray-language">中</span><time data-time title="当前时间">--:--</time></div>
  </footer>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-vista-desktop]');
  if (root) {
    const win = root.querySelector<HTMLElement>('[data-aero-window]')!;
    const start = root.querySelector<HTMLElement>('[data-start-menu]')!;
    const startToggle = root.querySelector<HTMLButtonElement>('[data-start-toggle]')!;
    const task = root.querySelector<HTMLButtonElement>('[data-taskbar-window]')!;
    const search = root.querySelector<HTMLInputElement>('[data-start-search]')!;
    const names: Record<string, string> = { welcome:'欢迎中心', files:'个人文件夹', network:'网络和共享中心', recycle:'回收站', appearance:'个性化', help:'帮助和支持' };
    const skinNames: Record<string, string> = {vista:'Windows Vista', xp:'Windows XP', win2000:'Windows 2000', win98:'Windows 98', osx:'Mac OS X Leopard'};
    const applySkin = (skin: string, save = true) => {
      if (!skinNames[skin]) skin = 'vista';
      root.dataset.desktopSkin = skin;
      root.querySelector('.welcome-copy h1')!.textContent = skin === 'osx' ? '欢迎使用 Mac' : '欢迎中心';
      root.querySelector('.desktop-shortcut[data-open="appearance"] > span')!.textContent = skin === 'osx' ? '系统偏好设置' : '个性化';
      root.querySelectorAll<HTMLButtonElement>('[data-skin-choice]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.skinChoice === skin)));
      root.querySelector('[data-skin-description]')!.textContent = `${skinNames[skin]} 风格桌面`;
      root.querySelector('[data-skin-brand]')!.textContent = skinNames[skin];
      root.querySelector('[data-signature-brand]')!.textContent = skinNames[skin];
      root.querySelector<HTMLElement>('[data-vista-options]')!.hidden = skin !== 'vista';
      const status = root.querySelector('[data-skin-status]')!;
      status.textContent = `当前主题：${skinNames[skin]}${save ? ' · 已保存，下次访问自动使用' : ''}`;
      if (save) {
        try { localStorage.setItem('museum-desktop-skin', skin); }
        catch { status.textContent = `当前主题：${skinNames[skin]} · 当前浏览器无法保存，刷新后恢复默认`; }
      }
    };
    root.querySelectorAll<HTMLButtonElement>('[data-skin-choice]').forEach(button => button.addEventListener('click', () => applySkin(button.dataset.skinChoice!)));
    applySkin(root.dataset.desktopSkin || 'vista', false);
    window.addEventListener('storage', event => {if(event.key === 'museum-desktop-skin') applySkin(event.newValue || 'vista', false);});
    let current = 'welcome';
    const closeStart = () => { start.hidden = true; startToggle.setAttribute('aria-expanded', 'false'); };
    const showWindow = () => { win.hidden = false; task.classList.add('active'); win.focus({preventScroll:true}); };
    const hideWindow = () => { win.hidden = true; task.classList.remove('active'); task.focus({preventScroll:true}); };
    const open = (view: string) => {
      if (!names[view]) return;
      current = view;
      root.querySelectorAll<HTMLElement>('[data-view]').forEach(panel => panel.hidden = panel.dataset.view !== view);
      ['[data-caption]', '[data-address]', '[data-taskbar-title]'].forEach(selector => { root.querySelector(selector)!.textContent = names[view]; });
      root.querySelector('[data-status]')!.textContent = view === 'welcome' ? '欢迎使用数字博物馆' : names[view];
      win.setAttribute('aria-label', names[view]);
      closeStart(); showWindow();
    };
    root.querySelectorAll<HTMLElement>('[data-open]').forEach(button => button.addEventListener('click', () => open(button.dataset.open!)));
    root.querySelector('[data-back]')!.addEventListener('click', () => open('welcome'));
    root.querySelector('[data-minimize]')!.addEventListener('click', hideWindow);
    root.querySelector('[data-close]')!.addEventListener('click', hideWindow);
    task.addEventListener('click', () => { closeStart(); win.hidden ? open(current) : hideWindow(); });
    const maximize = root.querySelector<HTMLButtonElement>('[data-maximize]')!;
    const toggleMaximize = () => { const active = win.classList.toggle('maximized'); maximize.setAttribute('aria-label', active ? '还原' : '最大化'); maximize.title = active ? '还原' : '最大化'; };
    maximize.addEventListener('click', toggleMaximize);
    startToggle.addEventListener('click', () => { const show = start.hidden; start.hidden = !show; startToggle.setAttribute('aria-expanded', String(show)); if(show) search.focus(); });
    root.querySelector('[data-dismiss-start]')!.addEventListener('click', () => {closeStart(); startToggle.focus();});
    root.querySelectorAll('[data-show-desktop]').forEach(button => button.addEventListener('click', () => {closeStart(); hideWindow();}));
    root.querySelectorAll('[data-toggle-gadgets]').forEach(button => button.addEventListener('click', () => { const gadgets = root.querySelector<HTMLElement>('[data-gadgets]')!; gadgets.hidden = !gadgets.hidden; closeStart(); if(gadgets.hidden) root.querySelector<HTMLButtonElement>('.personalize-links [data-toggle-gadgets]')?.focus(); }));
    document.addEventListener('pointerdown', event => { if (!start.hidden && event.target instanceof Node && !start.contains(event.target) && !startToggle.contains(event.target)) closeStart(); });
    document.addEventListener('keydown', event => { if(event.key === 'Escape' && !start.hidden) { closeStart(); startToggle.focus(); } });
    const filterPrograms = () => { let count = 0; root.querySelectorAll<HTMLElement>('[data-program]').forEach(item => { item.hidden = !item.dataset.program!.includes(search.value.trim()); if(!item.hidden) count++; }); root.querySelector<HTMLElement>('[data-start-empty]')!.hidden = count > 0; };
    search.addEventListener('input', filterPrograms);
    root.querySelector('[data-all-programs]')!.addEventListener('click', () => {search.value = ''; filterPrograms(); search.focus();});
    root.querySelectorAll<HTMLButtonElement>('[data-color]').forEach(button => button.addEventListener('click', () => {root.dataset.color = button.dataset.color; root.querySelectorAll('[data-color]').forEach(item => { item.classList.toggle('selected', item === button); item.setAttribute('aria-pressed', String(item === button)); });}));
    root.querySelector<HTMLInputElement>('[data-transparency]')!.addEventListener('change', event => root.classList.toggle('opaque', !(event.target as HTMLInputElement).checked));
    root.querySelector('[data-wallpaper]')!.addEventListener('click', event => { const active = root.classList.toggle('alternate-wallpaper'); (event.currentTarget as HTMLElement).setAttribute('aria-pressed', String(active)); });
    const drag = root.querySelector<HTMLElement>('[data-drag-handle]')!;
    drag.addEventListener('dblclick', event => { if(!(event.target as HTMLElement).closest('button')) toggleMaximize(); });
    let dragging: { x:number; y:number; left:number; top:number; id:number } | null = null;
    drag.addEventListener('pointerdown', event => { if(event.button !== 0 || (event.target as HTMLElement).closest('button') || win.classList.contains('maximized') || window.innerWidth <= 700) return; const rect = win.getBoundingClientRect(); dragging = { x:event.clientX, y:event.clientY, left:rect.left, top:rect.top, id:event.pointerId }; drag.setPointerCapture(event.pointerId); event.preventDefault(); });
    drag.addEventListener('pointermove', event => { if(!dragging) return; win.style.left = `${Math.max(0, Math.min(window.innerWidth-win.offsetWidth, dragging.left+event.clientX-dragging.x))}px`; win.style.top = `${Math.max(0, Math.min(window.innerHeight-90, dragging.top+event.clientY-dragging.y))}px`; win.style.setProperty('--desktop-window-top', win.style.top); });
    const stopDrag = () => { dragging = null; };
    drag.addEventListener('pointerup', stopDrag); drag.addEventListener('pointercancel', stopDrag); drag.addEventListener('lostpointercapture', stopDrag);
    window.addEventListener('resize', () => { win.style.left = ''; win.style.top = ''; win.style.removeProperty('--desktop-window-top'); });
    const updateClock = () => {
      const now = new Date(); const time = now.toLocaleTimeString('zh-CN', {hour:'2-digit', minute:'2-digit', hour12:false});
      const timeEl = root.querySelector<HTMLTimeElement>('[data-time]')!; timeEl.textContent = time; timeEl.dateTime = now.toISOString(); root.querySelector('[data-mac-time]')!.textContent = `${now.toLocaleDateString('zh-CN', {weekday:'short'})} ${time}`; timeEl.title = now.toLocaleDateString('zh-CN', {dateStyle:'full'});
      root.querySelector('[data-clock-label]')!.setAttribute('aria-label', `当前时间 ${time}`);
      const rotation = (selector:string, angle:number) => {root.querySelector<HTMLElement>(selector)!.style.transform = `translateX(-50%) rotate(${angle}deg)`;};
      rotation('[data-hour-hand]', (now.getHours()%12)*30+now.getMinutes()/2); rotation('[data-minute-hand]', now.getMinutes()*6+now.getSeconds()/10); rotation('[data-second-hand]', now.getSeconds()*6);
