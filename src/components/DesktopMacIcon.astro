---
interface Props { name: string; size: number; }
const { name, size } = Astro.props;
const id = `mac-${name}-${Math.random().toString(36).slice(2,8)}`;
---
<svg class="mac-desktop-icon" width={size} height={size} viewBox="0 0 80 80" fill="none" aria-hidden="true">
<defs>
<linearGradient id={`${id}-metal`} x1="10" y1="0" x2="57" y2="78" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".4" stop-color="#b8bec3"/><stop offset=".6" stop-color="#f5f5f6"/><stop offset="1" stop-color="#737b84"/></linearGradient>
<linearGradient id={`${id}-folder`} x2="0" y2="1"><stop stop-color="#c6eaff"/><stop offset=".1" stop-color="#83bddc"/><stop offset=".5" stop-color="#70a7c7"/><stop offset="1" stop-color="#a9d5e9"/></linearGradient>
<radialGradient id={`${id}-aqua`} cx=".4" cy=".25" r=".85"><stop stop-color="#d1f5ff"/><stop offset=".35" stop-color="#53b0ec"/><stop offset=".75" stop-color="#0864ba"/><stop offset="1" stop-color="#07346d"/></radialGradient>
<linearGradient id={`${id}-screen`} x2="1" y2="1"><stop stop-color="#10193a"/><stop offset=".45" stop-color="#5e4293"/><stop offset=".7" stop-color="#a378b3"/><stop offset="1" stop-color="#152957"/></linearGradient>
</defs>
<ellipse cx="40" cy="73" rx="30" ry="3" fill="#000" opacity=".2"/>
{name==='computer' && <><path d="M32 57h16l2 12 11 4H20l11-4z" fill={`url(#${id}-metal)`} stroke="#78818a"/><rect x="5" y="8" width="70" height="51" rx="4" fill={`url(#${id}-metal)`} stroke="#666e75"/><path d="M8 11h64v39H8z" fill="#131619"/><path d="M11 14h58v33H11z" fill={`url(#${id}-screen)`}/><path d="m11 39 45-25h13v8L28 47H11" fill="#fff" opacity=".12"/><path d="m16 40 43-22M28 44l31-26" stroke="#d9b9ee" opacity=".5"/><circle cx="40" cy="54" r="2" fill="#5d6670"/><path d="M24 72h34" stroke="white"/></>}
{['folder','documents','pictures'].includes(name) && <><path d="M6 18h25l6 6h36v43H6z" fill="#4b85a8" stroke="#315f81"/><path d="M8 19h23l6 6h34" stroke="#d5f0fc"/><path d="M9 27h61v36H9z" fill="#eaf5fb"/><path d="M4 31h72l-4 38H8z" fill={`url(#${id}-folder)`} stroke="#527c97"/><path d="M6 33h68M10 67h60" stroke="#d3efff" opacity=".8"/>{name==='pictures' ? <><rect x="24" y="39" width="32" height="23" rx="1" fill="#d4ecf5" stroke="#5f91b0"/><path d="M27 42h26v17H27z" fill="#669cba"/><circle cx="47" cy="46" r="3" fill="#d3e8eb"/><path d="m27 58 8-10 6 6 5-4 7 9z" fill="#b3d5df"/></> : <><path d="M29 42h22v20H29z" fill="#7faac4" stroke="#5f91ae"/><path d="M33 46h14M33 50h14M33 54h10" stroke="#b8d9e9"/></>}</>}
{name==='network' && <><circle cx="40" cy="39" r="31" fill={`url(#${id}-metal)`} stroke="#647781"/><circle cx="40" cy="39" r="27" fill={`url(#${id}-aqua)`} stroke="#326485"/>{Array.from({length:16},(_,i)=><path d="M40 14v4" stroke="white" stroke-opacity=".75" transform={`rotate(${i*22.5} 40 39)`}/>)}<path d="m40 39 17-20-10 28z" fill="#ee6458" stroke="#953b36"/><path d="m40 39-17 20 10-28z" fill="#f4f6f9" stroke="#8ba8bf"/><circle cx="40" cy="39" r="3" fill="#dbe9f5"/><path d="M18 26q22-27 44 0-23-7-44 0" fill="#fff" opacity=".4"/></>}
{name==='recycle' && <><path d="m18 16 5 53q17 7 34 0l5-53z" fill={`url(#${id}-metal)`} fill-opacity=".65" stroke="#71828e"/>{Array.from({length:8},(_,i)=><path d={`M${21+i*5} 20  ${25+i*4} 67`} stroke="#4b626e" stroke-opacity=".7"/>)}{Array.from({length:9},(_,i)=><path d={`M${19+i*.45} ${24+i*5}h${42-i}`} stroke="#dce8eb" stroke-width="2"/>)}<ellipse cx="40" cy="17" rx="23" ry="6" fill={`url(#${id}-metal)`} stroke="#73818a"/><ellipse cx="40" cy="17" rx="19" ry="3" fill="#354b59"/><path d="M26 68q14 5 28 0" stroke="#eff9ff" stroke-width="2"/></>}
{name==='person' && <><rect x="14" y="7" width="52" height="63" rx="4" fill="#795132" stroke="#49321f"/><rect x="18" y="9" width="45" height="57" rx="2" fill="#b88d57" stroke="#dcc09a"/><path d="M23 10v55" stroke="#735233"/><circle cx="44" cy="30" r="9" fill="#e1c296"/><path d="M29 55v-6c0-14 29-14 29 0v6z" fill="#e1c296"/>{[18,30,42,54].map(y=><rect x="10" y={y} width="11" height="4" rx="2" fill={`url(#${id}-metal)`} stroke="#697276"/>)}<path d="M66 16h4v10h-4M66 31h4v10h-4M66 46h4v10h-4" fill="#d7b77b"/></>}
{name==='paint' && <><rect x="8" y="8" width="64" height="62" rx="8" fill={`url(#${id}-metal)`} stroke="#616b76"/><rect x="12" y="12" width="56" height="54" rx="5" fill="#737f8b"/><g transform="translate(40 39)">{Array.from({length:12},(_,i)=><path d="m-5-26 1-6h8l1 6" fill="#e2e6e8" stroke="#596774" transform={`rotate(${i*30})`}/>)}<circle r="25" fill={`url(#${id}-metal)`} stroke="#4e5c68"/><circle r="16" fill="#4c5e6b" stroke="#f2f5f6"/><circle r="8" fill={`url(#${id}-metal)`} stroke="#223845"/></g></>}
{name==='music' && <><circle cx="38" cy="39" r="29" fill={`url(#${id}-metal)`} stroke="#83929c"/><circle cx="38" cy="39" r="23" stroke="#fff"/><circle cx="38" cy="39" r="6" fill="#b3c9d6"/><path d="M37 22v34c-13-4-17 10-5 10 6 0 9-4 9-9V31l18-5v24c-14-3-17 10-5 10 5 0 9-4 9-9V15z" fill={`url(#${id}-aqua)`} stroke="#246898"/></>}
</svg>
