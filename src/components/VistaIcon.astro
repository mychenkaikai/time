---
import DesktopMacIcon from './DesktopMacIcon.astro';
import DesktopClassicIcon from './DesktopClassicIcon.astro';
interface Props { name: string; size?: number; }
const { name, size = 48 } = Astro.props;
const id = `vi-${name}-${Math.random().toString(36).slice(2, 9)}`;
---
<svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" class="vista-icon">
  <defs>
    <linearGradient id={`${id}-blue`} x1="12" y1="6" x2="48" y2="55" gradientUnits="userSpaceOnUse"><stop stop-color="#d7f8ff"/><stop offset=".43" stop-color="#47b6e8"/><stop offset=".46" stop-color="#1389c6"/><stop offset="1" stop-color="#064676"/></linearGradient>
    <linearGradient id={`${id}-silver`} x1="15" y1="9" x2="40" y2="58" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".48" stop-color="#dbe6ec"/><stop offset=".5" stop-color="#8798a2"/><stop offset="1" stop-color="#e6eef0"/></linearGradient>
    <linearGradient id={`${id}-folder`} x1="27" y1="17" x2="31" y2="58" gradientUnits="userSpaceOnUse"><stop stop-color="#fff3b6"/><stop offset=".5" stop-color="#f7cc60"/><stop offset="1" stop-color="#d49423"/></linearGradient>
    <linearGradient id={`${id}-green`} x1="15" y1="9" x2="45" y2="58" gradientUnits="userSpaceOnUse"><stop stop-color="#d0fda8"/><stop offset=".45" stop-color="#77bf3e"/><stop offset="1" stop-color="#23671a"/></linearGradient>
  </defs>
  <ellipse cx="32" cy="58" rx="23" ry="3" fill="#001423" opacity=".2"/>
  {name === 'computer' && <>
    <path d="M26 46h13l2 8 9 3H15l10-3z" fill={`url(#${id}-silver)`} stroke="#65747e"/>
    <rect x="6" y="8" width="52" height="39" rx="3" fill={`url(#${id}-silver)`} stroke="#43505b"/>
    <rect x="10" y="12" width="44" height="29" fill={`url(#${id}-blue)`} stroke="#33444f"/>
    <path d="M11 39c14-26 26-6 42-23v24H11" fill="#71c956" opacity=".75"/><path d="M11 13h40L11 34z" fill="white" opacity=".24"/>
    <circle cx="32" cy="44" r="1" fill="#4ac3f0"/>
  </>}
  {(name === 'folder' || name === 'documents' || name === 'pictures') && <>
    <path d="M7 14h19l5 6h25v35H7z" fill="#d6a54e" stroke="#8d6829"/>
    <path d="M10 17h15l5 6h23v29H10z" fill="#ffe9a4"/>
    <path d="M16 12h29v35H16z" fill="#f8fcff" stroke="#98b5c4"/>
    <path d="M21 19h19M21 24h19M21 29h15" stroke="#a8bfca" stroke-width="2"/>
    <path d="M5 29h54l-6 27H10z" fill={`url(#${id}-folder)`} stroke="#ad7f2b"/>
    <path d="M8 31h47" stroke="#fff6d7"/>
    {name === 'pictures' && <g transform="rotate(9 43 40)"><rect x="29" y="28" width="29" height="24" fill="white" stroke="#80949f"/><path d="M32 31h23v17H32z" fill="#7fc9e8"/><circle cx="49" cy="35" r="3" fill="#fff3aa"/><path d="m32 47 7-10 5 7 4-5 7 9H32" fill="#499454"/></g>}
  </>}
  {name === 'network' && <>
    <circle cx="31" cy="28" r="23" fill={`url(#${id}-blue)`} stroke="#285d82"/>
    <path d="m18 9 7 4 2 7-6 7-7-2-5 6M40 9l-6 9 5 9 9 2 5 8M25 31l11 3 4 7-8 12-5-9z" fill="#79b24c" stroke="#478344"/>
    <path d="M13 13c10-10 25-8 33 2-17-7-28 2-32 9z" fill="white" opacity=".35"/>
    <rect x="32" y="37" width="26" height="18" rx="2" fill={`url(#${id}-silver)`} stroke="#647886"/><rect x="35" y="40" width="20" height="11" fill={`url(#${id}-blue)`}/><path d="M41 56h9l3 3H38z" fill="#becbd1"/>
  </>}
  {name === 'recycle' && <>
    <path d="m15 16 4 39q13 7 26 0l4-39" fill={`url(#${id}-silver)`} fill-opacity=".85" stroke="#718d9c"/>
    <ellipse cx="32" cy="16" rx="17" ry="5" fill="#d9edf2" stroke="#718d9c"/><ellipse cx="32" cy="16" rx="13" ry="3" fill="#879ba4"/>
    <path d="m27 31 5-8 6 9-4-1-2-3-2 4m9 2 5 8-11 1 3-3h4l-2-4m-9 9-10-1 5-10 1 4-2 4h5" fill="#3b9c4d" stroke="#2c813b" stroke-width=".7"/>
    <path d="m19 23 3 29M44 23l-2 28" stroke="white" opacity=".65"/>
  </>}
  {name === 'music' && <>
    <circle cx="29" cy="31" r="24" fill={`url(#${id}-silver)`} stroke="#7a91a1"/><circle cx="29" cy="31" r="19" stroke="white"/><circle cx="29" cy="31" r="6" fill="#7c929f"/><circle cx="29" cy="31" r="3" fill="#e9f5fa"/>
    <path d="M31 17v30c-12-4-15 9-6 10 5 1 10-2 10-7V26l17-5v20c-12-4-15 9-6 10 5 1 10-2 10-7V10z" fill={`url(#${id}-blue)`} stroke="#286783"/>
  </>}
  {name === 'person' && <>
    <rect x="8" y="6" width="48" height="50" rx="5" fill={`url(#${id}-blue)`} stroke="#476c89"/>
    <path d="M12 10h40v18L12 37z" fill="white" opacity=".3"/>
    <circle cx="32" cy="24" r="10" fill="#f5e5ca" stroke="#b6a990"/><path d="M15 50v-7c0-13 34-13 34 0v7" fill="#f0eee3" stroke="#b6c4c9"/>
  </>}
  {name === 'paint' && <>
    <path d="M30 8C6 8 2 36 15 48c8 8 12 0 14-4 4-9 13 8 23-1C67 27 49 8 30 8" fill="#f2dc9c" stroke="#a28b57"/>
    <circle cx="21" cy="20" r="5" fill="#e66a49"/><circle cx="36" cy="17" r="5" fill="#f7cf36"/><circle cx="48" cy="28" r="5" fill="#69ac4c"/><circle cx="17" cy="35" r="5" fill="#43a2db"/><path d="m28 55 24-35 5 3-23 35z" fill="#985424" stroke="#6c4323"/><path d="m28 55 6 3-10 3z" fill="#36434a"/>
  </>}
</svg>

<DesktopClassicIcon name={name} size={size}/>

<DesktopMacIcon name={name} size={size}/>
