---
/**
 * TopNav - 顶部导航栏组件
 * 显示网站主导航
 */

interface Props {
  currentPath?: string;
}

import {
  getAboutPath,
  getArchivePath,
  getHomePath,
  getTagIndexPath,
} from '../lib/routes';

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: '🏠 首页', path: '/', href: getHomePath() },
  { label: '📚 全部文章', path: '/archive', href: getArchivePath() },
  { label: '🏷️ 标签', path: '/tags', href: getTagIndexPath() },
  { label: 'ℹ️ 关于', path: '/about', href: getAboutPath() },
];
---

<nav class="top-nav">
  <div class="nav-brand">
    <span class="nav-icon">🖥️</span>
    <span class="nav-title">怀旧数字博物馆</span>
  </div>
  
  <div class="nav-right">
    <ul class="nav-menu">
      {navItems.map((item) => (
        <li class="nav-item">
          <a 
            href={item.href} 
            class:list={['nav-link', { active: currentPath === item.path }]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <button type="button" class="search-btn" data-site-search-trigger aria-label="打开搜索">🔍</button>
  </div>
</nav>

<style>
  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .search-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.2em;
    padding: 0 5px;
    opacity: 0.8;
  }
  
  .search-btn:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .top-nav {
    background: var(--titlebar-bg);
    color: var(--titlebar-text);
    padding: var(--spacing-sm) var(--spacing-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--border-dark, #808080);
    margin-bottom: var(--spacing-md);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-weight: bold;
    font-size: var(--font-size-lg);
  }

  .nav-icon {
    font-size: 1.5em;
  }

  .nav-menu {
    display: flex;
    gap: var(--spacing-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    margin: 0;
  }

  .nav-link {
    display: block;
    padding: var(--spacing-xs) var(--spacing-sm);
    color: var(--titlebar-text);
    text-decoration: none;
    background: transparent;
    border: 1px solid transparent;
    transition: all 0.2s;
  }

  .nav-link:hover {
    background: var(--link-hover-bg, rgba(0, 0, 0, 0.1));
    color: var(--link-hover-text, inherit);
  }

  .nav-link.active {
    background: var(--button-bg, #eeeeee);
    border-color: var(--border-dark, #808080);
    font-weight: bold;
  }

  .nav-link:active {
    transform: translate(1px, 1px);
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .top-nav {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .nav-menu {
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-link {
      font-size: var(--font-size-sm);
      padding: var(--spacing-xs);
    }
  }
</style>
