---
import Search from './Search.astro';
import WindowFrame from './WindowFrame.astro';
---

<div class="search-modal" data-search-modal-root hidden>
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <WindowFrame title="🔎 Find Relics">
      <div class="search-container">
        <Search />
        <div class="modal-actions">
          <button type="button" data-search-close>Close</button>
        </div>
      </div>
    </WindowFrame>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('[data-search-modal-root]').forEach((modalRoot) => {
    const modal = modalRoot;
    const shellRoot = modal.closest('[data-site-shell]') || document;
    const overlay = modal.querySelector('.modal-overlay');
    const closeBtn = modal.querySelector('[data-search-close]');

    const closeSearch = () => {
      modal.hidden = true;
    };

    const openSearch = () => {
      modal.hidden = false;

      window.setTimeout(() => {
        const input = modal.querySelector('input');

        if (input) {
          input.focus();
        }
      }, 100);
    };

    shellRoot.addEventListener('site-search:open', openSearch);
    overlay?.addEventListener('click', closeSearch);
    closeBtn?.addEventListener('click', closeSearch);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) {
        closeSearch();
      }
    });
  });
</script>


<style>
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10000;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  .modal-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 600px;
  }

  .search-container {
    padding: 10px;
  }

  .modal-actions {
    margin-top: 10px;
    text-align: right;
  }

  [data-search-close] {
    min-width: 80px;
  }
</style>
