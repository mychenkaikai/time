---
import ContentLayout from '../../layouts/ContentLayout.astro';
import WindowFrame from '../../components/WindowFrame.astro';
import { getPublishedPosts, getTags } from '../../lib/posts';
import { getHomePath, getTagPath } from '../../lib/routes';

const allPosts = await getPublishedPosts();
const tags = getTags(allPosts);
const pageTitle = 'Tags Cloud';
---

<ContentLayout title={pageTitle} currentPath="/tags">
  <WindowFrame title="🏷️ All Tags">
    <div class="tags-container">
      {tags.length > 0 ? (
        <ul class="tags-list">
          {tags.map((tag) => (
            <li class="tag-item">
              <a href={getTagPath(tag)}>#{tag}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p>No tags found.</p>
      )}
    </div>
  </WindowFrame>
  
  <div style="text-align: center; margin-top: 20px;">
    <a href={getHomePath()} class="back-link">← Back to Home</a>
  </div>
</ContentLayout>

<style>
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .tag-item a {
    display: inline-block;
    background: #fff;
    border: 1px solid #808080;
    padding: 4px 8px;
    text-decoration: none;
    box-shadow: 1px 1px 0 #000;
  }
  
  .tag-item a:hover {
    background: #000080;
    color: #fff;
  }
</style>
