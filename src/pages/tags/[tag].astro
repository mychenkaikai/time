---
import ContentLayout from '../../layouts/ContentLayout.astro';
import WindowFrame from '../../components/WindowFrame.astro';
import { getPublishedPosts, getPostsByTag, getTags } from '../../lib/posts';
import { getPostPath, getTagIndexPath } from '../../lib/routes';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const uniqueTags = getTags(allPosts);

  return uniqueTags.map((tag) => {
    const filteredPosts = getPostsByTag(allPosts, tag);
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

// Sort posts by date
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<ContentLayout title={`Tag: ${tag}`} currentPath="/tags">
  <WindowFrame title={`🏷️ Tag: ${tag}`}>
    <ul class="post-list tree-view">
      {posts.map((post) => (
        <li>
          <a href={getPostPath(post.slug)}>
            {post.data.title}
          </a>
          <span style="float: right; color: #666;">
            {post.data.date.toISOString().split('T')[0]}
          </span>
        </li>
      ))}
    </ul>
  </WindowFrame>

  <div style="text-align: center; margin-top: 20px;">
    <a href={getTagIndexPath()} class="back-link">← All Tags</a>
  </div>
</ContentLayout>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .post-list li {
    padding: 8px;
    border-bottom: 1px dotted #808080;
  }
  
  .post-list li:last-child {
    border-bottom: none;
  }
  
  .post-list a {
    text-decoration: none;
    font-weight: bold;
  }
  
  .post-list a:hover {
    text-decoration: underline;
  }
</style>
