---
/**
 * 关于页面 - 介绍网站和项目
 */

import ContentLayout from '../layouts/ContentLayout.astro';
import WindowFrame from '../components/WindowFrame.astro';
---

<ContentLayout title="关于" description="关于怀旧数字博物馆" currentPath="/about">
  <WindowFrame title="ℹ️ 关于本站">
    <div class="about-container">
      <section class="about-section">
        <h1>🖥️ 怀旧数字博物馆</h1>
        <p class="subtitle">收集旧互联网与旧生活记忆的安静角落</p>
      </section>

      <hr />

      <section class="about-section">
        <h2>📖 项目愿景</h2>
        <p>
          这是一个以怀旧为主题的个人站点，记录旧网页、旧设备、旧声音，
          以及那些不太起眼、却会在很多年后忽然想起的生活细节。
        </p>
        <p>
          与其说它是一个“博物馆”，不如说是把散落的旧时光重新摆上架：
          让记忆有地方停，让阅读有一点慢下来的仪式感。
        </p>
      </section>

      <hr />

      <section class="about-section">
        <h2>🎨 设计理念</h2>
        <ul>
          <li><strong>内容优先</strong>：先把记忆写具体，再让风格为内容服务</li>
          <li><strong>多主题浏览</strong>：不同主题对应不同年代和设备气质</li>
          <li><strong>保留旧网页感</strong>：尽量留下链接、边框、窗口和分栏带来的阅读氛围</li>
          <li><strong>轻量打开</strong>：静态生成，尽可能快地进入内容本身</li>
        </ul>
      </section>

      <hr />

      <section class="about-section">
        <h2>🎯 主题风格</h2>
        <div class="theme-list">
          <div class="theme-item">
            <h3>Retro Web (90s)</h3>
            <p>还原 90 年代真实网页风格，白色背景、蓝色链接、Times New Roman 字体。</p>
          </div>

          <div class="theme-item">
            <h3>Windows 98</h3>
            <p>经典的 Win98 配色方案，灰色背景、3D 边框效果。</p>
          </div>

          <div class="theme-item">
            <h3>Windows XP</h3>
            <p>Luna 蓝绿配色，柔和的界面风格。</p>
          </div>

          <div class="theme-item">
            <h3>Mac OS 9</h3>
            <p>Platinum 灰色主题，经典 Mac 风格。</p>
          </div>
        </div>
      </section>

      <hr />

      <section class="about-section">
        <h2>⚙️ 技术栈</h2>
        <ul>
          <li><strong>框架</strong>：Astro 4.x（静态站点生成）</li>
          <li><strong>内容管理</strong>：Content Collections（类型安全）</li>
          <li><strong>样式</strong>：纯 CSS + CSS Variables（主题系统）</li>
          <li><strong>托管</strong>：GitHub Pages + Cloudflare CDN</li>
        </ul>
      </section>

      <hr />

      <section class="about-section">
        <h2>📝 写作规范</h2>
        <p>所有文章使用 Markdown 编写，目前主要围绕以下几类内容展开：</p>
        <ul>
          <li>旧互联网与旧网页</li>
          <li>童年物件、设备与媒介</li>
          <li>音乐、电视、游戏与节日记忆</li>
          <li>带有主题、标签和情绪标记的文章归档</li>
          <li>必要时穿插音乐和视频，帮助还原当时的氛围</li>
        </ul>
      </section>

      <hr />

      <section class="about-section">
        <h2>🎵 特色功能</h2>
        <ul>
          <li>✅ 多主题一键切换</li>
          <li>✅ 背景音乐播放器（按文章内容选择开启）</li>
          <li>✅ CRT 扫描线滤镜（按需切换）</li>
          <li>✅ 移动端阅读提示</li>
          <li>✅ 文章归档和标签系统</li>
          <li>✅ 可检索的站内搜索</li>
        </ul>
      </section>

      <hr />

      <section class="about-section">
        <h2>📧 联系方式</h2>
        <p>
          目前这个站点仍在慢慢补内容。
        </p>
        <p>
          如果后续开放评论区之外的联系方式，会在这里更新。
        </p>
      </section>

      <hr />

      <section class="about-section footer-section">
        <p class="copyright">
          © 2024 怀旧数字博物馆<br />
          用 ❤️ 和 Astro 打造
        </p>
        <p class="version">
          慢一点，看一会儿旧时光。
        </p>
      </section>
    </div>
  </WindowFrame>
</ContentLayout>
<style>
  /* 主布局 */
  .about-container {
    padding: var(--spacing-lg);
    background: #ffffff;
    line-height: 1.8;
  }

  .about-section {
    margin-bottom: var(--spacing-lg);
  }

  .about-section h1 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-sm);
    text-align: center;
  }

  .subtitle {
    text-align: center;
    color: var(--border-dark);
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-md);
  }

  .about-section h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-md);
    color: var(--link-color);
  }

  .about-section h3 {
    font-size: var(--font-size-base);
    margin-bottom: var(--spacing-xs);
  }

  .about-section ul {
    margin-left: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .about-section li {
    margin-bottom: var(--spacing-xs);
  }

  .about-section p {
    margin-bottom: var(--spacing-md);
  }

  hr {
    border: none;
    border-top: 1px solid var(--border-dark);
    margin: var(--spacing-xl) 0;
  }

  /* 主题列表 */
  .theme-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .theme-item {
    padding: var(--spacing-md);
    border: 1px solid var(--border-dark);
    background: #f9f9f9;
  }

  .theme-item h3 {
    color: var(--link-color);
    margin-bottom: var(--spacing-sm);
  }

  .theme-item p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--text-color);
  }

  /* 页脚区域 */
  .footer-section {
    text-align: center;
    margin-top: var(--spacing-xl);
  }

  .copyright {
    font-size: var(--font-size-base);
    font-weight: bold;
    margin-bottom: var(--spacing-sm);
  }

  .version {
    font-size: var(--font-size-sm);
    color: var(--border-dark);
  }

  @media (max-width: 768px) {
    .about-container {
      padding: var(--spacing-md);
    }

    .theme-list {
      grid-template-columns: 1fr;
    }
  }
</style>
